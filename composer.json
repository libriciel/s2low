{
  "name": "s2low/s2low",
  "license": "AGPL-3.0-only",
  "require": {
    "ext-SimpleXML": "^8.1",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "^8.1.0",
    "ext-ftp": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "^8.1",
    "ext-libxml": "^8.1",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcntl": "^8.1",
    "ext-pdo": "*",
    "ext-pgsql": "*",
    "ext-redis": "^5.3",
    "ext-ssh2": "*",
    "ext-zip": "^1.15",
    "ext-zlib": "*",
    "doctrine/annotations": "^1.13",
    "egulias/email-validator": "^3.2",
    "erusev/parsedown": "^1.7",
    "ezyang/htmlpurifier": "^4.14",
    "libriciel/tdt-lib-actes": "^2.0.3",
    "malkusch/lock": "^2.1",
    "masterminds/html5": "^2.7",
    "monolog/monolog": "^3.5",
    "mtdowling/supervisor-event": "^1.0",
    "pda/pheanstalk": "^3.1",
    "php-imap/php-imap": "^5.0",
    "php-opencloud/openstack": "^3.0",
    "phpseclib/phpseclib": "~3.0",
    "symfony/console": "^6.4",
    "symfony/filesystem": "^6.4",
    "symfony/finder": "^6.4",
    "symfony/mailer": "^6.4",
    "symfony/monolog-bridge": "^6.4",
    "symfony/monolog-bundle": "^3.8",
    "symfony/process": "^6.4",
    "symfony/symfony": "^6.4",
    "symfony/twig-bundle": "^6.4",
    "twig/twig": "^3.8"
  },
  "require-dev": {
    "doctrine/instantiator": "^1.2",
    "mikey179/vfsstream": "^1.5",
    "phpspec/prophecy": "^1.19",
    "phpunit/php-code-coverage": "^9.2",
    "phpunit/php-file-iterator": "^3.0",
    "phpunit/php-timer": "^5.0",
    "phpunit/php-token-stream": "^3.1",
    "phpunit/phpunit": "^9.5",
    "sebastian/comparator": "^4.0",
    "sebastian/diff": "^4.0",
    "sebastian/environment": "^5.1",
    "sebastian/exporter": "^4.0",
    "sebastian/global-state": "^5.0",
    "sebastian/recursion-context": "^4.0",
    "sebastian/version": "^3.0",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-cover": "phpunit --coverage-text --colors=never --coverage-clover coverage/coverage.xml --log-junit coverage/logfile.xml"
  },
  "autoload": {
    "psr-4": {
      "S2low\\": "src/",
      "Legacy\\": "public.ssl/modules/mail/lib"
    },
    "classmap": [
      "lib",
      "model",
      "controller",
      "class",
      "ext",
      "public.ssl/modules/mail/lib",
      "public.ssl/modules/mail/om",
      "public.ssl/modules/mail/controller",
      "public.ssl/modules/actes/class/",
      "public.ssl/modules/helios/class/",
      "docker-resources"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "S2low\\Tests\\": "tests/"
    },
    "classmap": [
      "test/PHPUnit"
    ]
  }
}
