{
  "name": "s2low/s2low",
  "license": "AGPL-3.0-only",
  "require": {
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-ftp": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-pgsql": "*",
    "ext-redis": "*",
    "ext-simplexml": "*",
    "ext-ssh2": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "aws/aws-sdk-php": "^3.356",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^2.20",
    "egulias/email-validator": "^3.2",
    "erusev/parsedown": "^1.7",
    "ezyang/htmlpurifier": "^4.14",
    "libriciel/tdt-lib-actes": "^2.0.3",
    "malkusch/lock": "^3.1",
    "masterminds/html5": "^2.7",
    "monolog/monolog": "^3.5",
    "mtdowling/supervisor-event": "^1.0",
    "pda/pheanstalk": "^3.1",
    "php-imap/php-imap": "^5.0",
    "php-opencloud/openstack": "^3.0",
    "phpdocumentor/reflection-docblock": "^5.4",
    "phpseclib/phpseclib": "~3.0",
    "phpstan/phpdoc-parser": "^1.29",
    "symfony/console": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/filesystem": "^6.4",
    "symfony/finder": "^6.4",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/mailer": "^6.4",
    "symfony/monolog-bridge": "^6.4",
    "symfony/monolog-bundle": "^3.8",
    "symfony/process": "^6.4",
    "symfony/property-access": "^6.4",
    "symfony/property-info": "^6.4",
    "symfony/security-bundle": "6.4.*",
    "symfony/serializer": "^6.4",
    "symfony/twig-bundle": "^6.4",
    "symfony/ux-twig-component": "^2.36",
    "symfony/yaml": "^6.4",
    "twig/twig": "^3.8",
    "ext-xmlreader": "*"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.2",
    "mikey179/vfsstream": "^1.5",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.5",
    "rector/rector": "^2.2",
    "squizlabs/php_codesniffer": "^3.9",
    "symfony/browser-kit": "^6.4",
    "symfony/debug-bundle": "^6.4",
    "symfony/maker-bundle": "^1.67",
    "symfony/web-profiler-bundle": "^6.4"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-cover": "phpunit --coverage-text --colors=never --coverage-clover coverage/coverage.xml --log-junit coverage/logfile.xml",
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "autoload": {
    "psr-4": {
      "S2low\\": "src/",
      "IntegrationTests\\": "integration_tests",
      "S2lowLegacy\\Lib\\": "lib/",
      "S2lowLegacy\\Mail\\": "public.ssl/modules/mail/lib/",
      "S2lowLegacy\\Boot\\": "docker-resources/",
      "S2lowLegacy\\Controller\\": "controller/"
    },
    "classmap": [
      "lib",
      "model",
      "controller",
      "class",
      "ext",
      "public.ssl/admin/authorities/",
      "public.ssl/modules/mail/lib",
      "public.ssl/modules/mail/controller",
      "public.ssl/modules/actes/class/",
      "public.ssl/modules/helios/class/",
      "docker-resources"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "S2low\\Tests\\": "tests/"
    },
    "classmap": [
      "test/PHPUnit"
    ]
  },
  "extra": {
    "symfony": {
      "docker": false,
      "require": "6.4.*"
    }
  }
}
