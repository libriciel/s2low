{
  "name": "s2low/s2low",
  "version": "4.3.4",
  "require": {
    "symfony/filesystem": "^3.4",
    "monolog/monolog": "^1.23",
    "mtdowling/supervisor-event": "^1.0",
    "pda/pheanstalk": "^3.1",
    "symfony/process": "^5.1",
    "php-imap/php-imap": "^5.0",
    "ext-fileinfo": "^8.1.0",
    "ext-SimpleXML": "^8.1",
    "malkusch/lock": "^2.1",
    "ext-redis": "^5.3",
    "ext-pcntl": "^8.1",
    "ext-libxml": "^8.1",
    "symfony/finder": "^4.3",
    "ext-zip": "^1.15",
    "ext-iconv": "*",
    "php-opencloud/openstack": "^3.0",
    "ext-ftp": "*",
    "symfony/console": "^5.1",
    "symfony/monolog-bridge": "^5.1",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-json": "^8.1",
    "libriciel/tdt-lib-actes": "^2.0",
    "ext-dom": "*",
    "erusev/parsedown": "^1.7",
    "ext-pgsql": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-zlib": "*",
    "ext-gd": "*",
    "squizlabs/php_codesniffer": "^3.7",
    "ezyang/htmlpurifier": "^4.14"
  },

  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpunit/php-code-coverage": "^9.2",
    "mikey179/vfsstream": "^1.5",
    "sebastian/version": "^3.0",
    "sebastian/global-state": "*",
    "sebastian/recursion-context": "*",
    "sebastian/exporter": "*",
    "sebastian/comparator": "^4.0",
    "phpspec/prophecy": "*",
    "sebastian/environment": "^5.1",
    "sebastian/diff": "^4.0",
    "phpunit/php-timer": "^5.0",
    "phpunit/php-file-iterator": "^3.0",
    "doctrine/instantiator": "^1.2",
    "phpunit/php-token-stream": "^3.1"
  },
  "scripts": {
    "test": "phpunit",
    "test-cover": "phpunit --coverage-text --colors=never --coverage-clover coverage/coverage.xml --log-junit coverage/logfile.xml"
  },
  "autoload": {
    "psr-4": {
      "S2low\\": "src/"
    },
    "classmap": [
      "lib",
      "model",
      "controller",
      "class",
      "ext",
      "public.ssl/modules/mail/lib",
      "public.ssl/modules/mail/om",
      "public.ssl/modules/mail/controller",
      "public.ssl/modules/actes/class/",
      "public.ssl/modules/helios/class/",
      "docker-resources"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "S2low\\Tests\\": "tests/"
    },
    "classmap": [
      "test/PHPUnit"
    ]
  }
}
