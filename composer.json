{
  "name": "s2low/s2low",
  "version": "4.3.4",
  "require": {
    "symfony/filesystem": "^3.4",
    "monolog/monolog": "^1.23",
    "mtdowling/supervisor-event": "^1.0",
    "pda/pheanstalk": "^3.1",
    "symfony/process": "^5.1",
    "php-imap/php-imap": "^3.0",
    "ext-fileinfo": "^8.1.0",
    "ext-SimpleXML": "^8.1",
    "malkusch/lock": "^2.1",
    "ext-redis": "^5.3",
    "ext-pcntl": "^8.1",
    "ext-libxml": "^8.1",
    "symfony/finder": "^4.3",
    "ext-zip": "^1.15",
    "ext-iconv": "*",
    "php-opencloud/openstack": "^3.0",
    "ext-ftp": "*",
    "symfony/console": "^5.1",
    "symfony/monolog-bridge": "^5.1",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-json": "^8.1",
    "libriciel/tdt-lib-actes": "^2.0",
    "ext-dom": "*",
    "erusev/parsedown": "^1.7",
    "ext-pgsql": "*",
    "ext-intl": "*"
  },

  "require-dev": {
    "phpunit/phpunit": "^8.4",
    "phpunit/php-code-coverage": "^7.0",
    "mikey179/vfsstream": "^1.5",
    "sebastian/version": "^2.0",
    "sebastian/global-state": "^3.0",
    "sebastian/recursion-context": "^3.0",
    "sebastian/exporter": "^3.1",
    "sebastian/comparator": "^3.0",
    "phpspec/prophecy": "^1.9",
    "sebastian/environment": "^4.2",
    "sebastian/diff": "^3.0",
    "phpunit/php-timer": "^2.1",
    "phpunit/php-file-iterator": "^2.0",
    "doctrine/instantiator": "^1.2",
    "phpunit/php-token-stream": "^3.1"
  },
  "scripts": {
    "test": "phpunit",
    "test-cover": "phpunit --coverage-text --colors=never"
  },
  "autoload": {
    "psr-4": {
      "S2low\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "S2low\\Tests\\": "tests/"
    }
  }
}
