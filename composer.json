{
  "name": "S2low/S2low",
  "version": "2.6.7",
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "libriciel/tdt-lib-actes",
        "version": "0.0.32",
        "dist": {
          "type": "tar",
          "url": "https://ressources.libriciel.fr/s2low/tdt-lib-actes-master.tar.gz?i=0.0.32"
        },
        "autoload": {
          "psr-4": {
            "Libriciel\\LibActes\\": "src"
          },
          "classmap": ["src/"]
        }
      }
    }
  ],

  "require": {
    "rackspace/php-opencloud": "^1.16",
    "libriciel/tdt-lib-actes": "*",
    "symfony/filesystem": "^3.4",
    "monolog/monolog": "^1.23",
    "mtdowling/supervisor-event": "^1.0",
    "pda/pheanstalk": "^3.1",
    "symfony/process": "^3.4",
    "php-imap/php-imap": "^3.0",
    "ext-fileinfo": "^1.0",
    "ext-SimpleXML": "^7.2",
    "malkusch/lock": "^2.1",
    "ext-redis": "^5.0",
    "ext-pcntl": "^7.2",
    "ext-libxml": "^7.2",
    "symfony/finder": "^4.3"
  },

  "require-dev": {
    "phpunit/phpunit": "^8.4",
    "phpunit/php-code-coverage": "^7.0",
    "mikey179/vfsStream": "^1.5",
    "sebastian/version": "^2.0",
    "sebastian/global-state": "^3.0",
    "sebastian/recursion-context": "^3.0",
    "sebastian/exporter": "^3.1",
    "sebastian/comparator": "^3.0",
    "phpspec/prophecy": "^1.9",
    "phpunit/phpunit-mock-objects": "^6.1",
    "sebastian/environment": "^4.2",
    "sebastian/diff": "^3.0",
    "phpunit/php-timer": "^2.1",
    "phpunit/php-file-iterator": "^2.0",
    "doctrine/instantiator": "^1.2",
    "phpunit/php-token-stream": "^3.1"
  },
  "scripts": {
    "test": "phpunit",
    "test-cover": "phpunit --coverage-text --colors=never"
  }

}
