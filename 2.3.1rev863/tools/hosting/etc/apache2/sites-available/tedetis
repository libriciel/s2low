<VirtualHost *:80>
  ServerAdmin webmaster@ntsys.fr
  ServerName __SITENAME__
  DocumentRoot /var/www/tedetis/public

  <Directory /var/www/tedetis/public>
        Options +FollowSymLinks -Indexes
  </Directory>

  ErrorLog /var/log/apache2/__SITENAME__-error.log
  CustomLog /var/log/apache2/__SITENAME__-access.log combined
</VirtualHost>
