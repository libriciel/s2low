{
  "name": "s2low/migration-s3",
  "require": {
    "aws/aws-sdk-php": "^3.369",
    "vlucas/phpdotenv": "^5.6",
    "php-opencloud/openstack": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "doctrine/instantiator": "^1.5"
  },
  "config": {
    "platform": {
      "php": "8.1.99"
    },
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
