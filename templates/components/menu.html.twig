{# global/components/menu.html.twig #}
    {% if app.user.name is defined %}
        <div id="menu-header">
            {% if this.certificateSharedWithOtherUsers %}
                <a class="menu-logout" href="/deconnexion" title="Se déconnecter"><span>Se déconnecter</span></a>
            {% endif %}
            <div class="menu-identity">
                <span class="menu-identity-initials" aria-hidden="true">{{ this.initials }}</span>
                <span class="menu-identity-civility">
                    <span class="menu-identity-name">{{ app.user.givenname }} {{ app.user.name }}</span>
                    <span class="menu-identity-role">{{ app.user.role|labeliseRole }}</span>
                </span>
            </div>
            {% if this.affiliationName is not null %}
                <div class="menu-affiliation menu-affiliation-{{ this.affiliationType }}">{{ this.affiliationName }}</div>
            {% endif %}
        </div>
        {% include 'components/certificat_expiration_warning.html.twig' with {'nb_day_before_certificate_expire': app.user.certExpirationDate|days_ago} %}
        {% if this.messageAdminTitle is not null %}
            <a class="label label-{{ this.getCssLevel|toCssClass }} menu-message-admin" href="/">{{ this.messageAdminTitle }}</a>
        {% endif %}
    {% else %}
        <div id="menu-header">
            <a href="{{ url_index_ssl }}">Accéder au site</a><br/>
            (Certificat nécessaire)
        </div>
    {% endif %}
    {% include 'components/menu-sections.html.twig' %}
