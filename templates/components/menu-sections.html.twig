{% set module_menu = getModuleMenu(app.user) %}
<ul class="text-menu nav">
    {% if app.user.isAnyAdmin %}
        <li class="menu-list-title">Administration</li>
    {% endif %}
    {% if app.user.isSuperAdmin %}
        <li><a href="/admin/modules/admin_modules.php">Gestion des modules</a></li>
        <li><a href="/admin/groups/admin_groups.php">Gestion des groupes</a></li>
    {% endif %}
    {% if app.user.isGroupOrSuperAdmin %}
        <li><a href="/admin/authorities/admin_authorities.php">Gestion des collectivités</a></li>
    {% endif %}
    {% if app.user.isAuthorityAdmin %}
        <li><a href="/modules/mail/index.php?command=annuaire">Carnet d'adresses de la collectivité</a></li>
        <li><a href="/admin/authorities/admin_authority_edit.php?id={{ app.user.authorityId }}">Paramètres
                collectivité</a></li>
    {% endif %}
    {% if app.user.isAnyAdmin %}
        <li><a href="/admin/users/admin_users.php">Gestion des utilisateurs</a></li>
        <li><a href="/admin/services/admin_services.php">Gestion des services</a></li>
    {% endif %}
    {% if app.user.isSuperAdmin %}
        <li><a href="/admin/utilities/index.php">Utilitaires système</a></li>
    {% endif %}
    {% for module in module_menu.administrations %}
        <li><a href="/modules/{{ module.name() }}/admin/index.php">Utilitaires module {{ module.name() }}</a></li>
    {% endfor %}

    <li class="menu-list-title">Modules</li>
    {% for module in module_menu.transactions %}
        <li><a href="/modules/{{ module.name }}/index.php">{{ module.menu_entry }}</a></li>
    {% else %}
        <li>Aucun module accessible</li>
    {% endfor %}

    {% if module_menu.exports is not empty %}
        <li class="menu-list-title">Export des informations</li>
        {% for module in module_menu.exports %}
            <li><a href="/modules/{{ module.name() }}/{{ module.name() }}_export.php">Exports module {{ module.name() }}</a></li>
        {% endfor %}
    {% endif %}

    <li class="menu-list-title">Suivi{% if app.user.isAnyAdmin %} du site{% endif %}</li>
    <li><a href="/common/logs_view.php">Journal des événements</a></li>
    {% for module in module_menu.statistics %}
        <li><a href="/modules/{{ module.name() }}/{{ module.name() }}_stats.php">Statistiques
                module {{ module.name() }}</a></li>
    {% endfor %}
</ul>
