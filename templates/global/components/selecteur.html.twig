<select name="{{ name }}" id="{{ name }}" class="form-control {% if css_class is defined %}{{ css_class }}{% endif %}">
    <option value="">Choisissez</option>
    {% if data is defined %}
    {% for key, value in data %}
    <option value="{{ key }}" {{ key == selectedValue ? 'selected="selected"' : '' }}>
        {{ value }}
    </option>
    {% endfor %}
    {% endif %}
</select>
