<script>$(function () {
        $("#datepicker_{{ name }}").datepicker({
            "altFormat": "yy-mm-dd",
            "dateFormat": "dd MM yy",
            "altField": "#{{ name }}"
        });
    });</script>
<input type="text" class="form-control" value="{% if label_date == null %}Choisir une date{% else %}{{ label_date }}{% endif %}" name="datepicker_{{ name }}"
       id="datepicker_{{ name }}"><input type="hidden" id="{{ name }}" name="{{ name }}" value="{{ date }}"/>
