<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="fr">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <meta name="robots" content="noindex">
    <title>{% block title %}{{ title }}{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset(bootstrapMinCssUrl) }}"/>
        <link rel="stylesheet" type="text/css" href="{{ asset(styleBsCssUrl) }}"/>
    {% endblock %}

    {% block javascripts %}
        <script type="text/javascript" src="{{ asset(jqueryJsUrl) }}"></script>
        <script type="text/javascript" src="{{ asset(jqueryuiJsUrl) }}"></script>
        <script type="text/javascript" src="{{ asset(tedetisJsUrl) }}"></script>
        <script type="text/javascript" src="{{ asset(bootstrapJsUrl) }}"></script>
    {% endblock %}
</head>

<body>

{% block header %}
    {{ include('components/header.html.twig') }}
{% endblock %}

<div class="container">
    <div class="row">
        {% if app.user %}
            {{ include('components/sidebar.html.twig') }}
        {% endif %}

        <div id="content" class="col-md-9" role="main">
            {{ include('components/flash_messages.html.twig') }}

            <h1>{% block h1 %}{% endblock %}</h1>
            {% block body %}{% endblock %}
        </div>
    </div>
</div>

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}

</body>
</html>
