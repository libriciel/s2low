#! /bin/bash
set -e

# TODO vérification de l'installation de composer ?
echo "Génération des fichiers de configuration"
/bin/bash /var/www/s2low/docker-resources/generate-config.sh > /data/config/DockerSettings.php
/bin/bash /var/www/s2low/docker-resources/generate-symfony-config.sh > /data/config/.env
export -p > /data/config/container_environment.sh

/bin/bash /var/www/s2low/docker-resources/create-directory-structure.sh

if [ "${PUBLISH_SIMULATEUR}" = true ] ; then
    a2ensite simulateur
else
    a2dissite simulateur
fi
a2ensite s2low-apache-config.conf

env | awk -F= '{ if ($2 ~ /^".*"$/) print $0; else gsub(/"/, "\\\"",$2); print $1 "=\"" $2 "\"" }' > /data/config/acme.env

/var/www/s2low/docker-resources/certificate/acme.sh --standalone

cp /etc/ssl/certs/* /data/certificate/truststore/

if [ -z "$DONT_RETRIEVE_VALIDCA" ] ; then
  # Ajout des ACs du ministère
  /usr/local/bin/recup_ac_ministere.sh /etc/s2low/ssl/ /data/certificate/truststore/
fi

if [ -z "$DONT_INIT_DATABASE" ] ; then
  #On attend que la base de données soit accessible avant de l'initialiser
  if [ ! "${POSTGRES_HOST}" ] ; then
    POSTGRES_HOST="db"
  fi

  until nc -z -v -w30 ${POSTGRES_HOST} 5432
  do
    echo 'Waiting for database connection...'
    sleep 5
  done

  php /var/www/s2low/bin/console doctrine:migrations:migrate --no-interaction
  php /var/www/s2low/bin/console init:bootstrap
fi

#Si la variable OPENSTACK_ENABLE n'existe pas il faut la définir sinon supervisor retournera une erreur
#je sais ce que ça coute, pour mémoire https://stackoverflow.com/a/34212572
if [ ! "${OPENSTACK_ENABLE}" ]
then
  echo '🚨 la variable OPENSTACK_ENABLE devrait être dans le docker-compose !'
  export OPENSTACK_ENABLE=false
fi

exec "$@"
