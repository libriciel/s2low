#! /bin/bash
set -e

# TODO vérification de l'installation de composer ?
echo "Génération des fichiers de configuration"
/bin/bash /var/www/s2low/docker-resources/generate-config.sh > /data/config/DockerSettings.php
/bin/bash /var/www/s2low/docker-resources/generate-symfony-config.sh > /data/config/.env

/bin/bash /var/www/s2low/docker-resources/create-directory-structure.sh

if [ "${PUBLISH_SIMULATEUR}" = true ] ; then
    a2ensite simulateur
else
    a2dissite simulateur
fi
a2ensite s2low-apache-config.conf

#voir si on peu s'assurer que le dossier letsencrypt est un point de montage
if [ "${LETSENCRYPT_DOMAIN}" ] && [ "${LETSENCRYPT_EMAIL}" ]; then
    if [ -f "/etc/apache2/ssl/fullchain.pem" ] ; then
            certbot --logs-dir /data/log/ --work-dir /data/run --http-01-port 8080 renew
    else
        certbot --http-01-port 8080 --logs-dir /data/log/ --work-dir /data/run --standalone --noninteractive --agree-to --preferred-challenges http -d "${LETSENCRYPT_DOMAIN}" -d "${LETSENCRYPT_SUB_DOMAIN}" -m "${LETSENCRYPT_EMAIL}" certonly
        ln -s "/etc/letsencrypt/live/${LETSENCRYPT_DOMAIN}/fullchain.pem" /etc/apache2/ssl/
        ln -s "/etc/letsencrypt/live/${LETSENCRYPT_DOMAIN}/privkey.pem" /etc/apache2/ssl/
    fi

fi

if [ "${LETSENCRYPT_MAILSEC_DOMAIN}" ] && [ "${LETSENCRYPT_EMAIL}" ] ; then
    if [ -f "/etc/apache2/ssl/mailsec_fullchain.pem" ] ; then
            certbot  --logs-dir /data/log/ --work-dir /data/run --http-01-port 80 renew
    else
        certbot --http-01-port 80 --logs-dir /data/log/ --work-dir /data/run --standalone --noninteractive --agree-to --preferred-challenges http -d ${LETSENCRYPT_MAILSEC_DOMAIN} -m ${LETSENCRYPT_EMAIL} certonly
        ln -s /etc/letsencrypt/live/${LETSENCRYPT_MAILSEC_DOMAIN}/fullchain.pem /etc/apache2/ssl/
        ln -s /etc/letsencrypt/live/${LETSENCRYPT_MAILSEC_DOMAIN}/privkey.pem /etc/apache2/ssl/
    fi
fi

cp /etc/ssl/certs/* /data/certificate/truststore/

if [ -z "$DONT_RETRIEVE_VALIDCA" ] ; then
  # Ajout des ACs du ministère
  /usr/local/bin/recup_ac_ministere.sh /etc/s2low/ssl/ /data/certificate/truststore/
fi

if [ -z "$DONT_INIT_DATABASE" ] ; then
  #On attend que la base de données soit accessible avant de l'initialiser
  if [ ! "${POSTGRES_HOST}" ] ; then
    POSTGRES_HOST="db"
  fi

  until nc -z -v -w30 ${POSTGRES_HOST} 5432
  do
    echo 'Waiting for database connection...'
    sleep 5
  done

  php /var/www/s2low/docker-resources/init-docker.php

  if [ "${POSTGRES_DATABASE_TEST}" ]; then
      php /var/www/s2low/docker-resources/init-bdd-test.php
  fi
fi

#Si la variable OPENSTACK_ENABLE n'existe pas il faut la définir sinon supervisor retournera une erreur
#je sais ce que ça coute, pour mémoire https://stackoverflow.com/a/34212572
if [ ! "${OPENSTACK_ENABLE}" ]
then
  echo '🚨 la variable OPENSTACK_ENABLE devrait être dans le docker-compose !'
  export OPENSTACK_ENABLE=false
fi

exec "$@"
