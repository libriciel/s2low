MAILSEC_OPENSTACK_AUTHENTICATION_URL_V3="https://auth.cloud.ovh.net/v3"
MAILSEC_OPENSTACK_USERNAME=
MAILSEC_OPENSTACK_PASSWORD=
MAILSEC_OPENSTACK_TENANT=
MAILSEC_OPENSTACK_REGION=GRA
MAILSEC_OPENSTACK_SWIFT_CONTAINER_PREFIX=

CLOUD_PROVIDER_ENDPOINT=
CLOUD_PROVIDER_KEY=
CLOUD_PROVIDER_SECRET=
CLOUD_BUCKET_ACTE_ENVELOPPE=
