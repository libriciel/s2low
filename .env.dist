##### apache container
WEB_CERTIFICATES_PATH=/data/s2low/web/certificates
ACME_DATADIR=/data/s2low/web/letsencrypt
WEB_LOGS_PATH=/data/s2low/web/log

#### app container
APP_CERTIFICATES_PATH=/data/s2low/app/certificates
APP_LOGS_PATH=/data/s2low/app/log
WORKSPACE_VOLUME=/data/s2low/app/tdt-workspace

