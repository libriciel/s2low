{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["project_25_bot_7b3ca4887e2797fc60846fd1099a8070"],
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "branchPrefix": "renovate-",
  "labels": ["deps", "renovate"],
  "prHourlyLimit": 5,
  "dependencyDashboard": true,
  "stabilityDays": 2,
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Désactive toutes les mises à jour majeures",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Bloque les mises à jour des images Docker Ubuntu",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "enabled": false
    },
    {
      "matchPackagePatterns": ["^.*postgre(?:s|sql).*$"],
      "enabled": false
    },
    {
      "description": "Automerge patch & minor",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Mises à jour Composer",
      "matchManagers": ["composer"],
      "groupName": "Composer deps",
      "groupSlug": "composer-deps"
    },
    {
      "description": "Mises à jour NPM",
      "matchManagers": ["npm"],
      "groupName": "NPM deps",
      "groupSlug": "npm-deps"
    },
    {
      "description": "Symfony écosystème (composer)",
      "matchPackagePatterns": ["^symfony/"],
      "groupName": "Symfony",
      "semanticCommitScope": "symfony"
    },
    {
      "description": "Infra & runtime",
      "matchUpdateTypes": ["patch", "minor"],
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Infra",
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
