

#--------------------------------------------------------------------------------
#
#   VARIABLE D'ENVIRONNEMENT DU DOCKER S2LOW
#
#--------------------------------------------------------------------------------

# Email admin technique
EMAIL_ADMIN_TECHNIQUE=tedetis@localhost

# URL du site
S2LOW_WEBSITE=s2low.libriciel.fr

# Hote de la base de donn�es
POSTGRES_HOST=db

# Hote de la base de donn�es
POSTGRES_HOST=db

# Nom de la base de donn�es
POSTGRES_DB=tedetis

# Login de l'utilisateur qui se connecte � la base de donn�es
POSTGRES_USER=tedetis

# Mot de passe de l'utilisateur qui se connecte � la base de donn�es
POSTGRES_PASSWORD=tedetis


# Serveur FTP pour les fichier helios
HELIOS_FTP_SERVER=ftp

# Port
HELIOS_FTP_PORT=21

# Utiliser FPT en mode passif
HELIOS_FTP_PASSIVE_MODE=false

# Login FTP
HELIOS_FTP_LOGIN=helios

# Mot de passe FTP
HELIOS_FTP_PASSWORD=helios

# R�pertoire d'envoi sur le serveur FTP
#doit obligatoire finir par un / TODO � corriger
HELIOS_SENDING_DESTINATION=/entree/

# R�pertoire de r�cup�ration sur le serveur FTP
#doit obligatoire finir par un / TODO � corriger
HELIOS_FTP_RESPONSE_SERVER_PATH=/sortie/

# Serveur SMTP pour l'envoi de mail
SMTP_SERVER=

# Port du serveur SMTP
SMTP_PORT=25

# URL du script make.sh fourni pour l'installation de l'application Libersign
LIBERSIGN_INSTALLER=

IMAP_SERVER=

IMAP_LOGIN=

IMAP_PASS=


#
# Variable facultative pour les environnements de d�veloppement et de test unitaire
#
#

# H�te de la base de donn�es de test
POSTGRES_HOST_TEST=db_test

# Nom de la base de donn�es de test
POSTGRES_DATABASE_TEST=tedetis

# Login de l'utilisateur qui se connecte � la base de donn�es de test
POSTGRES_USER_TEST=tedetis

# Mot de passe de l'utilisateur qui se connecte � la base de donn�es de test
POSTGRES_PASSWORD_TEST=tedetis


# Doit-on publier les simulateur Actes et Helios � partir du docker web
PUBLISH_SIMULATEUR=


#
# Variable permettant d'utiliser un backend OpenStack Swift pour stocker les "vieux" fichiers
#

OPENSTACK_AUTHENTICATION_URL_V3=https://auth.cloud.ovh.net/v3
OPENSTACK_USERNAME=
OPENSTACK_PASSWORD=
OPENSTACK_TENANT=
OPENSTACK_REGION=fr1

# Les containers cr�er par S2low commenceront par cette chaine de caract�re
# Exemple : s2low_exemple_pes_aller
OPENSTACK_SWIFT_CONTAINER_PREFIX=s2low_exemple_



#--------------------------------------------------------------------------------
#
#   VARIABLE D'ENVIRONNEMENT COMMUNE DES DOCKER-COMPOSE
#
#--------------------------------------------------------------------------------


# Emplacement du volume contenant le workspace
WORKSPACE_VOLUME=/data/workspace/


# Emplacement des certificat du serveur
SERVER_SSL_CERTIFICAT=/data/certificat/

# Emplacement du r�pertoire pgdata pour postgresql
POSTGRESQL_DATADIR=/data/pgdata/

LOG_PATH=/data/log


#--------------------------------------------------------------------------------
#
#   VARIABLE D'ENVIRONNEMENT DU DOCKER-COMPOSE DE DEVELOPPEMENT (override)
#
#--------------------------------------------------------------------------------


# Port de publication du site HTTP
WEB_HTTP_PORT=10080

# Port de publication du site HTTPS
WEB_HTTPS_PORT=10443

# Port de publication de phppgadmin
PHPPGADMIN_HTTP_PORT=10001

# Port de publication du simulateur
SIMULATEUR_SITE_PORT=10081

# Volume contenant les donn�es du simulateur
SIMULATEUR_WORKSPACE_DIRECTORY=/data/simulateur_workspace/


# Port de publication du FTP du simulateur Helios
FTP_PORT=10021

# Plage de port publi� pour le mode passif
PASV_MIN_PORT=65000
PASV_MAX_PORT=65004

# Port de publication du tedetis (partie java)
TOMCAT_PORT=8080

# Volumes contenant les fichiers actes pour le tedetis
ACTES_FILES_UPLOAD_ROOT=/data/workspace/actes/uploads/

# Emplacement du certificat d'horodatage (au format p12)
TIMESTAMP_CERTIFICAT_PATH=/data/certificat/s2low_timestamp_cert.pem.p12
TIMESTAMP_CERTIFICAT_PASSWORD=

# URL de l'outil de validation des signature PADES
PADES_VALID_URL=http://pades-valid:8080/

# Volume REDIS
REDIS_VOLUME=/data/redis

#Port pour la console beanstalked (developpement)
BEANSTALKD_CONSOLE_PORT=10002


MAILNAME=mail
ACTES_IMAP_LOGIN=mail@tedetis.org
ACTES_IMAP_PASSWORD=password
VOL_OPENSTACK=/data/openstask
POSTGRESQL_DATADIR_TEST=/data/pgdata_test

USE_LEGACY_BORDEREAU_MODEL=true