####SYSTEME#####

# Recuperation des listes de revocation des certificats
0 0 * * * root /usr/local/lib/tedetis/update_ca_crl /etc/tedetis/ssl/validca && /etc/init.d/apache2 restart >/dev/null 2>&1

# Nettoyage des messages recus ages de plus de 2 mois
30 0 * * * root find /var/lib/amavis/virusmails/ -type f -mtime +10 -delete; 

# Nettoie les traces de Tedetis
0 0 * * * www-data test -f /tmp/tedetis-trace.log && echo 0 > /tmp/tedetis-trace.log

#reinitialisation du compteur a 0 tous les jours
0 0  * * * www-data echo '001' > /tdt-workspace/helios/counter

# Nettoyage des messages temporaires ages de plus de 30 jours
31 0 * * * root find /opt/tomcat/temp/ -type f -mtime +10 -exec rm {} \;

